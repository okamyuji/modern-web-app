# アプリケーション設定
APP_NAME=deployment-demo
ENV=development
PORT=8080
VERSION=dev

# サーバー設定
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s

# データベース設定
DATABASE_URL=sqlite://deployment_demo.db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# セキュリティ設定
# /api/todos の Bearer トークン。ENV が development、test、testing 以外では32文字以上が必須。この3つで空なら認証なし
API_TOKEN=
ALLOWED_ORIGINS=http://localhost:8080,https://yourdomain.com

# Redis設定（セッション管理・キャッシュ用）
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# SMTP設定（メール送信用）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# 監視・ログ設定
LOG_LEVEL=debug
SENTRY_DSN=
PROMETHEUS_ENABLED=true
# 既定は127.0.0.1だけで待ち受ける。別ホストのPrometheusから取得するときだけ0.0.0.0にする
PROMETHEUS_HOST=127.0.0.1
PROMETHEUS_PORT=9090

# 外部サービス設定
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AWS設定（S3ファイルアップロード等）
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# その他
ENABLE_SWAGGER=true
# クライアントIPごとの1分あたりの /api/todos 要求数
API_RATE_LIMIT=100
CORS_ENABLED=true
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=